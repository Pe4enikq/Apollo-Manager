<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="using:Walkman.L3.AppShell.Controls"
             x:Class="Walkman.L3.AppShell.Controls.OnboardingOverlayControl"
             IsVisible="False">
  <Grid Background="{DynamicResource ModalBackdropBrush}">
    <Border Classes="aero-modal-card"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="640"
            MaxWidth="720"
            Padding="28,24">
      <Grid RowDefinitions="Auto,16,Auto,14,Auto,18,Auto">
        <!-- Header Row: Step Badge + Close (X) -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,14,*,Auto">
          <Border Grid.Column="0"
                  Classes="glass-clear-box"
                  Width="48"
                  Height="48"
                  CornerRadius="15">
            <ctrl:StrokeIcon x:Name="CardIconControl"
                             Width="22"
                             Height="22"
                             StrokeThickness="1.9"
                             Foreground="{DynamicResource AeroSkyInkBrush}" />
          </Border>

          <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
            <TextBlock x:Name="StepBadgeText"
                       FontFamily="{StaticResource AeroMonoFont}"
                       FontSize="10.5"
                       FontWeight="Bold"
                       LetterSpacing="0.9"
                       Foreground="{DynamicResource AeroSkyInkBrush}" />
            <TextBlock x:Name="CardTitleText"
                       FontSize="20"
                       FontWeight="Bold"
                       TextWrapping="Wrap" />
          </StackPanel>

          <Button Grid.Column="3"
                  Classes="glass-clear"
                  Width="30"
                  Height="30"
                  CornerRadius="15"
                  Padding="0"
                  VerticalAlignment="Top"
                  Click="OnCloseClicked"
                  ToolTip.Tip="Close Starting Guide (Esc)">
            <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.Close}" Width="12" Height="12" StrokeThickness="2.1" />
          </Button>
        </Grid>

        <!-- Body Card Well -->
        <Border Grid.Row="2" Classes="metal-well" Padding="18,16" CornerRadius="14">
          <StackPanel Spacing="10">
            <TextBlock x:Name="CardSubtitleText"
                       FontSize="13.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AeroInkBrush}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="CardBodyText"
                       FontSize="13"
                       LineHeight="20"
                       Foreground="{DynamicResource AeroMutedBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- Highlight Tip Well -->
        <Border Grid.Row="4"
                Classes="glass-clear-box"
                CornerRadius="12"
                Padding="14,10">
          <Grid ColumnDefinitions="Auto,10,*,Auto">
            <ctrl:StrokeIcon Grid.Column="0"
                             Data="{x:Static ctrl:AeroIcons.InfoCircle}"
                             Width="16"
                             Height="16"
                             Foreground="{DynamicResource AeroLimeInkBrush}"
                             VerticalAlignment="Center" />
            <TextBlock Grid.Column="2"
                       x:Name="CardTipText"
                       FontSize="12"
                       FontWeight="Medium"
                       Foreground="{DynamicResource AeroInkBrush}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
            <Button Grid.Column="3"
                    x:Name="ActionButton"
                    Classes="glass-clear"
                    CornerRadius="12"
                    Padding="10,5"
                    Margin="10,0,0,0"
                    Click="OnActionClicked">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock x:Name="ActionButtonText" FontSize="11.5" FontWeight="SemiBold" />
                <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.ArrowUpRight}" Width="12" Height="12" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <!-- Footer: Don't Show Again + Dots + Navigation Buttons -->
        <Grid Grid.Row="6" ColumnDefinitions="Auto,*,Auto">
          <CheckBox Grid.Column="0"
                    x:Name="DontShowAgainCheckBox"
                    Content="Don't show on startup"
                    FontSize="12"
                    Foreground="{DynamicResource AeroMutedBrush}"
                    VerticalAlignment="Center" />

          <StackPanel Grid.Column="1"
                      x:Name="DotsHost"
                      Orientation="Horizontal"
                      Spacing="7"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="glass-clear"
                    CornerRadius="14"
                    Padding="12,7"
                    Click="OnSkipClicked"
                    Content="Skip"
                    FontSize="12" />
            <Button x:Name="PreviousButton"
                    Classes="metal-button"
                    CornerRadius="14"
                    Padding="14,7"
                    Click="OnPreviousClicked"
                    Content="Back"
                    FontSize="12"
                    FontWeight="SemiBold" />
            <Button x:Name="NextButton"
                    Classes="metal-button under-glow-green"
                    CornerRadius="14"
                    Padding="18,7"
                    Click="OnNextClicked"
                    FontSize="12.5"
                    FontWeight="Bold" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
