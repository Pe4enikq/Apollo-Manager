<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Walkman.L3.AppShell.ViewModels"
             xmlns:core="using:Walkman.L3.AppShell.Core"
             xmlns:ctrl="using:Walkman.L3.AppShell.Controls"
             x:Class="Walkman.L3.AppShell.Views.FileManagerView"
             x:DataType="vm:MainWindowViewModel">
  <Grid RowDefinitions="Auto,16,*">
    <!-- Compact Header (clean static subtitle) -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Text="File Manager" Classes="view-title" />
        <TextBlock Text="{Binding TransferCodecSubtitle}" Classes="view-subtitle" />
      </StackPanel>
      <TextBlock Grid.Column="1"
                 Text="{Binding FileManagerHint}"
                 VerticalAlignment="Bottom"
                 FontSize="12"
                 FontWeight="Medium"
                 Foreground="{DynamicResource AeroSkyInkBrush}" />
    </Grid>

    <!-- 3-Column Split: Export Source | Machined Bento Console | Import Destination -->
    <Grid Grid.Row="2" ColumnDefinitions="*,16,318,16,*">
      <!-- LEFT PANE: EXPORT SOURCE (supports Explorer Drop + Select All) -->
      <Border x:Name="SourceDropPanel" Grid.Column="0" Classes="glass-frosted" Padding="16">
        <Grid RowDefinitions="Auto,12,*">
          <StackPanel Grid.Row="0" Spacing="8">
            <Grid ColumnDefinitions="*,Auto,6,Auto">
              <TextBlock Grid.Column="0"
                         Text="EXPORT SOURCE"
                         Classes="pane-section-header"
                         Foreground="{DynamicResource AeroSkyInkBrush}" />
              <Button Grid.Column="1"
                      Classes="glass-clear"
                      IsEnabled="{Binding IsFileTransferUnlocked}"
                      Command="{Binding ToggleSelectAllFmSourceCommand}"
                      Padding="9,4"
                      ToolTip.Tip="Select or deselect all source tracks (Ctrl+A)">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.CheckAll}" Width="12" Height="12" />
                  <TextBlock Text="Select All" FontSize="11" FontWeight="Medium" />
                </StackPanel>
              </Button>
              <Button Grid.Column="3"
                      Classes="glass-clear"
                      IsEnabled="{Binding IsFileTransferUnlocked}"
                      Command="{Binding BrowseFmLocationCommand}"
                      CommandParameter="left"
                      Padding="9,4">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.FolderOpen}" Width="12" Height="12" />
                  <TextBlock Text="Browse..." FontSize="11" FontWeight="Medium" />
                </StackPanel>
              </Button>
            </Grid>

            <Grid ColumnDefinitions="*,8,136">
              <ComboBox Grid.Column="0"
                        Classes="glass-select"
                        IsEnabled="{Binding IsFileTransferUnlocked}"
                        ItemsSource="{Binding AllLocations}"
                        SelectedItem="{Binding SelectedSourceLocation}"
                        HorizontalAlignment="Stretch"
                        Height="34" />
              <Grid Grid.Column="2">
                <TextBox x:Name="LeftSearchBox"
                         Classes="glass-input"
                         Text="{Binding FileManagerLeftSearch}"
                         Watermark="Search..."
                         Padding="28,4,26,4"
                         Height="34"
                         FontSize="12" />
                <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.Search}"
                                 Width="12"
                                 Height="12"
                                 Foreground="{DynamicResource AeroSubtleBrush}"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Margin="10,0,0,0"
                                 IsHitTestVisible="False" />
                <Button Classes="glass-clear"
                        IsVisible="{Binding FileManagerLeftSearch, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Command="{Binding ClearFmLeftSearchCommand}"
                        Width="18"
                        Height="18"
                        CornerRadius="9"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0"
                        ToolTip.Tip="Clear search">
                  <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.Close}" Width="9" Height="9" StrokeThickness="2" />
                </Button>
              </Grid>
            </Grid>
            <Grid ColumnDefinitions="*,6,Auto,6,Auto">
              <ComboBox Grid.Column="0"
                        Classes="glass-select"
                        ItemsSource="{Binding AvailableSortFields}"
                        SelectedItem="{Binding FmSourceSortField}"
                        Height="30"
                        Padding="8,2"
                        FontSize="11.5"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="Sort source tracks" />
              <Button Grid.Column="2"
                      Classes="glass-clear"
                      Height="30"
                      Padding="8,0"
                      Command="{Binding ToggleFmSourceSortDirectionCommand}"
                      ToolTip.Tip="Toggle sort direction">
                <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.SortArrows}" Width="12" Height="12" />
              </Button>
              <Button Grid.Column="4"
                      Classes="glass-clear"
                      Height="30"
                      Padding="8,0"
                      Command="{Binding CollapseAllFoldersCommand}"
                      CommandParameter="fmsrc"
                      ToolTip.ShowDelay="1000">
                <ToolTip.Tip>
                  <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.InfoCircle}" Width="12" Height="12" Foreground="{DynamicResource AeroSkyInkBrush}" />
                      <TextBlock Text="Info" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AeroSkyInkBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Collapses or expands all folder groups in Export Source." TextWrapping="Wrap" MaxWidth="220" FontSize="11.5" />
                  </StackPanel>
                </ToolTip.Tip>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.CollapseAll}" Width="12" Height="12" />
                  <TextBlock Text="Collapse All" FontSize="11.5" FontWeight="SemiBold" />
                </StackPanel>
              </Button>
            </Grid>
          </StackPanel>

          <!-- Column Headers + Scrollable Track List -->
          <Grid Grid.Row="2" RowDefinitions="Auto,*">
            <Grid Grid.Row="0"
                  ColumnDefinitions="52,*,76"
                  Margin="4,0,14,0"
                  Height="28">
              <TextBlock Grid.Column="0" Text="Sel" FontSize="11.5" Foreground="{DynamicResource AeroMutedBrush}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Track (drop audio here)" FontSize="11.5" Foreground="{DynamicResource AeroMutedBrush}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="Format" FontSize="11.5" Foreground="{DynamicResource AeroMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <ListBox Grid.Row="1"
                     Classes="aero-track-list"
                     AutoScrollToSelectedItem="False"
                     Padding="0,0,4,12"
                     ItemsSource="{Binding FileManagerSourceEntries}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="core:TrackListEntry">
                  <Panel>
                    <Button IsVisible="{Binding IsHeader}"
                            Classes="glass-clear"
                            Classes.folder-selected="{Binding HasSelectedTracks}"
                            Classes.folder-playing-selected="{Binding HasPlayingAndSelected}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="8,5"
                            Margin="0,5,0,2"
                            CornerRadius="9"
                            Click="OnFolderHeaderClicked">
                      <Button.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Select Folder" Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).SelectFolderByKeyCommand}" CommandParameter="{Binding HeaderKey}" />
                        </ContextMenu>
                      </Button.ContextMenu>
                      <Grid ColumnDefinitions="Auto,8,*,12,Auto,8,Auto">
                        <Panel Grid.Column="0" Width="13" Height="13" VerticalAlignment="Center">
                          <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.FolderClosed}" Width="13" Height="13" Foreground="{DynamicResource AeroSkyInkBrush}" IsVisible="{Binding !HasPlayingTrack}" />
                          <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.Play}" Width="11" Height="11" IsFilled="True" Foreground="{DynamicResource AeroLimeInkBrush}" IsVisible="{Binding HasPlayingTrack}" />
                        </Panel>
                        <TextBlock Grid.Column="2" Text="{Binding HeaderTitle}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="{Binding HeaderCountLabel}" FontFamily="{StaticResource AeroMonoFont}" FontSize="11" Foreground="{DynamicResource AeroMutedBrush}" VerticalAlignment="Center" />
                        <ctrl:StrokeIcon Grid.Column="6" Data="{x:Static ctrl:AeroIcons.ChevronDown}" Width="12" Height="12" IsVisible="{Binding IsExpanded}" />
                        <ctrl:StrokeIcon Grid.Column="6" Data="{x:Static ctrl:AeroIcons.ChevronRight}" Width="12" Height="12" IsVisible="{Binding !IsExpanded}" />
                      </Grid>
                    </Button>

                    <Border IsVisible="{Binding IsTrack}"
                            Classes="track-row"
                            Classes.selected="{Binding Track.IsSelected, FallbackValue=False}"
                            Classes.playing="{Binding Track.IsNowPlaying, FallbackValue=False}"
                            Padding="4,7"
                            Cursor="Hand"
                            PointerPressed="OnSourceRowPressed">
                      <Border.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Play / Pause" Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).PlayTrackFromMenuCommand}" CommandParameter="{Binding Track}" />
                          <MenuItem Header="Toggle Transfer Selection" Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ToggleSourceTrackSelectionCommand}" CommandParameter="{Binding Track}" />
                          <MenuItem Header="Stage into Target Collection" Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).StageSourceTrackToTargetCommand}" CommandParameter="{Binding Track}" />
                          <Separator />
                          <MenuItem Header="Edit Tags &amp; Lyrics" Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).OpenTrackInCustomizationCommand}" CommandParameter="{Binding Track}" />
                          <Separator />
                          <MenuItem Header="Remove from Library" Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).RemoveTrackFromLibraryCommand}" CommandParameter="{Binding Track}" />
                          <MenuItem Header="Delete File from PC..." Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).RequestDeleteTrackFromPcCommand}" CommandParameter="{Binding Track}" />
                        </ContextMenu>
                      </Border.ContextMenu>
                      <Grid ColumnDefinitions="28,24,*,76">
                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding Track.IsSelected, FallbackValue=False}"
                                  VerticalAlignment="Center"
                                  Click="OnSourceCheckBoxClicked" />
                        <Button Grid.Column="1"
                                Classes="glass-clear"
                                Classes.metal-button="{Binding Track.IsNowPlaying, FallbackValue=False}"
                                Classes.under-glow-green="{Binding Track.IsNowPlaying, FallbackValue=False}"
                                Width="22"
                                Height="22"
                                CornerRadius="11"
                                Padding="0"
                                VerticalAlignment="Center"
                                Click="OnPreviewTrackClicked"
                                ToolTip.Tip="Preview track">
                          <Panel>
                            <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.Pause}" Width="9" Height="9" IsFilled="True" IsVisible="{Binding Track.IsActivelyPlaying, FallbackValue=False}" />
                            <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.Play}" Width="10" Height="10" IsFilled="True" IsVisible="{Binding !Track.IsActivelyPlaying, FallbackValue=True}" Margin="1,0,0,0" />
                          </Panel>
                        </Button>
                        <StackPanel Grid.Column="2" Margin="6,0" VerticalAlignment="Center" Spacing="1">
                          <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding Track.Title}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                            <Border Grid.Column="1" Classes="demo-badge" IsVisible="{Binding Track.IsDemoItem, FallbackValue=False}" Margin="0,0,4,0">
                              <TextBlock Text="DEMO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AeroSkyInkBrush}" />
                            </Border>
                            <Border Grid.Column="2" Classes="demo-badge" VerticalAlignment="Center" IsVisible="{Binding Track.HasSubtitles, FallbackValue=False}">
                              <TextBlock Text="LRC" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AeroLimeInkBrush}" />
                            </Border>
                          </Grid>
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding Track.ArtistAndDuration}" FontSize="11.5" Foreground="{DynamicResource AeroMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                            <TextBlock Grid.Column="1" Text="{Binding Track.RatingFilledStars}" IsVisible="{Binding Track.HasRating, FallbackValue=False}" Classes="rating-stars-amber" />
                          </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="1">
                          <TextBlock Text="{Binding Track.Format}" FontFamily="{StaticResource AeroMonoFont}" FontSize="11.5" HorizontalAlignment="Right" />
                          <TextBlock Text="{Binding Track.SizeFormatted}" FontFamily="{StaticResource AeroMonoFont}" FontSize="11" Foreground="{DynamicResource AeroSubtleBrush}" HorizontalAlignment="Right" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </Panel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Grid>
      </Border>

      <!-- CENTER CONSOLE: FULL-HEIGHT BENTO HARDWARE FACEPLATE -->
      <ctrl:BrushedMetalPanel Grid.Column="2" IsDark="{Binding IsDark}" CornerRadiusValue="18">
        <Grid RowDefinitions="Auto,10,*,10,*,10,Auto" Margin="12">
          <!-- Row 0: Primary Transfer CTA + Swap + Queue Stats -->
          <StackPanel Grid.Row="0" Spacing="6">
            <Button Classes="metal-button"
                    Classes.under-glow-green="{Binding CanStartTransfer}"
                    IsEnabled="{Binding CanStartTransfer}"
                    Command="{Binding StartTransferCommand}"
                    HorizontalAlignment="Stretch"
                    Height="40">
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <TextBlock Text="{Binding TransferButtonLabel}" FontSize="13.5" FontWeight="Bold" />
                <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.ArrowRight}" Width="14" Height="14" StrokeThickness="2.1" />
              </StackPanel>
            </Button>

            <Grid ColumnDefinitions="*,6,*,6,Auto">
              <Button Grid.Column="0"
                      Classes="metal-button"
                      IsEnabled="{Binding IsFileTransferUnlocked}"
                      Command="{Binding SwapTransferEndpointsCommand}"
                      HorizontalAlignment="Stretch"
                      Height="30">
                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                  <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.Swap}" Width="12" Height="12" />
                  <TextBlock Text="Swap" FontSize="11.5" FontWeight="SemiBold" />
                </StackPanel>
              </Button>
              <Button Grid.Column="2"
                      Classes="metal-button"
                      Classes.under-glow-blue="{Binding HasPendingDeviceTableChanges}"
                      IsEnabled="{Binding CanCommitPendingDeviceChanges}"
                      Command="{Binding CommitPendingDeviceChangesCommand}"
                      HorizontalAlignment="Stretch"
                      Height="30"
                      ToolTip.ShowDelay="1000">
                <ToolTip.Tip>
                  <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.InfoCircle}" Width="12" Height="12" Foreground="{DynamicResource AeroSkyInkBrush}" />
                      <TextBlock Text="Info" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AeroSkyInkBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Commits pending folder order, track order, and tag edits to the Walkman OMGAUDIO database without uploading new tracks." TextWrapping="Wrap" MaxWidth="230" FontSize="11.5" />
                  </StackPanel>
                </ToolTip.Tip>
                <TextBlock Text="{Binding UpdateDeviceTableButtonLabel}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
              </Button>
              <Border Grid.Column="4" Classes="metal-well" Padding="8,0" CornerRadius="10" Height="30">
                <TextBlock Text="{Binding FmSelectedQueueSizeText}" FontFamily="{StaticResource AeroMonoFont}" FontSize="10.5" Foreground="{DynamicResource AeroSkyInkBrush}" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </StackPanel>

            <!-- Recessed Well 1: Upload Mode & Target Codec (Full-Height Bento Grid) -->
            <Border Grid.Row="2" Classes="metal-well" Padding="8,7" IsEnabled="{Binding IsFileTransferUnlocked}">
              <Grid RowDefinitions="Auto,7,*,7,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="UPLOAD MODE" FontSize="10" FontWeight="Bold" LetterSpacing="0.8" Foreground="{DynamicResource AeroMutedBrush}" />
                  <TextBlock Grid.Column="1" Text="{Binding FmModeHint}" FontSize="10" Foreground="{DynamicResource AeroSubtleBrush}" />
                </Grid>

                <Grid Grid.Row="2" RowDefinitions="*,5,*" ColumnDefinitions="*,5,*">
                  <Button Grid.Row="0" Grid.Column="0"
                          Classes="metal-button"
                          Classes.under-glow-green="{Binding FmQualityGreen}"
                          Classes.under-glow-blue="{Binding FmQualityBlue}"
                          IsEnabled="{Binding !IsFmModeLocked}"
                          Opacity="{Binding FmQualityOpacity}"
                          Command="{Binding SetUploadModeCommand}"
                          CommandParameter="{x:Static core:UploadMode.Quality}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ToolTip.ShowDelay="1000">
                    <ToolTip.Tip>
                      <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                      <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.InfoCircle}" Width="12" Height="12" Foreground="{DynamicResource AeroSkyInkBrush}" />
                      <TextBlock Text="Info" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AeroSkyInkBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                        <TextBlock Text="Prioritizes highest audio fidelity (ATRAC3plus 352k / lossless pass-through when supported)." TextWrapping="Wrap" MaxWidth="230" FontSize="11.5" />
                      </StackPanel>
                    </ToolTip.Tip>
                    <TextBlock Text="Quality" FontSize="11.5" FontWeight="SemiBold" />
                  </Button>
                  <Button Grid.Row="0" Grid.Column="2"
                          Classes="metal-button"
                          Classes.under-glow-green="{Binding FmFasterGreen}"
                          Classes.under-glow-blue="{Binding FmFasterBlue}"
                          IsEnabled="{Binding !IsFmModeLocked}"
                          Opacity="{Binding FmFasterOpacity}"
                          Command="{Binding SetUploadModeCommand}"
                          CommandParameter="{x:Static core:UploadMode.Faster}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ToolTip.ShowDelay="1000">
                    <ToolTip.Tip>
                      <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                      <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.InfoCircle}" Width="12" Height="12" Foreground="{DynamicResource AeroSkyInkBrush}" />
                      <TextBlock Text="Info" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AeroSkyInkBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                        <TextBlock Text="Optimizes transfer speed and compact storage using efficient 128–192k ATRAC3plus." TextWrapping="Wrap" MaxWidth="230" FontSize="11.5" />
                      </StackPanel>
                    </ToolTip.Tip>
                    <TextBlock Text="Faster" FontSize="11.5" FontWeight="SemiBold" />
                  </Button>
                  <Button Grid.Row="2" Grid.Column="0"
                          Classes="metal-button"
                          Classes.under-glow-green="{Binding FmAutoGreen}"
                          Classes.under-glow-blue="{Binding FmAutoBlue}"
                          IsEnabled="{Binding !IsFmModeLocked}"
                          Opacity="{Binding FmAutoOpacity}"
                          Command="{Binding SetUploadModeCommand}"
                          CommandParameter="{x:Static core:UploadMode.Auto}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ToolTip.ShowDelay="1000">
                    <ToolTip.Tip>
                      <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                      <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.InfoCircle}" Width="12" Height="12" Foreground="{DynamicResource AeroSkyInkBrush}" />
                      <TextBlock Text="Info" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AeroSkyInkBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                        <TextBlock Text="Automatically picks the best compatible codec and bitrate for your connected Walkman." TextWrapping="Wrap" MaxWidth="230" FontSize="11.5" />
                      </StackPanel>
                    </ToolTip.Tip>
                    <TextBlock Text="Auto" FontSize="11.5" FontWeight="SemiBold" />
                  </Button>
                  <Button Grid.Row="2" Grid.Column="2"
                          Classes="metal-button"
                          Classes.under-glow-green="{Binding FmCustomGreen}"
                          Classes.under-glow-blue="{Binding FmCustomBlue}"
                          IsEnabled="{Binding !IsFmModeLocked}"
                          Opacity="{Binding FmCustomOpacity}"
                          Command="{Binding SetUploadModeCommand}"
                          CommandParameter="{x:Static core:UploadMode.Custom}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ToolTip.ShowDelay="1000">
                    <ToolTip.Tip>
                      <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                      <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.InfoCircle}" Width="12" Height="12" Foreground="{DynamicResource AeroSkyInkBrush}" />
                      <TextBlock Text="Info" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AeroSkyInkBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                        <TextBlock Text="Unlocks manual target codec and bitrate selection from the dropdown below. (Recommended option)" TextWrapping="Wrap" MaxWidth="230" FontSize="11.5" />
                      </StackPanel>
                    </ToolTip.Tip>
                    <TextBlock Text="Custom" FontSize="11.5" FontWeight="SemiBold" />
                  </Button>
                </Grid>

                <Panel Grid.Row="4" Height="30">
                  <Border Classes="glass-clear-box" CornerRadius="8" IsVisible="{Binding !IsUploadCustom}" Padding="8,0">
                    <TextBlock Text="Codec managed automatically"
                               FontSize="10"
                               Foreground="{DynamicResource AeroSubtleBrush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                  </Border>
                  <ComboBox Classes="glass-select"
                            IsVisible="{Binding IsUploadCustom}"
                            ItemsSource="{Binding CustomCodecChoices}"
                            SelectedItem="{Binding FmCustomCodec}"
                            HorizontalAlignment="Stretch"
                            Height="30"
                            BorderBrush="#CC6CD434"
                            FontFamily="{StaticResource AeroMonoFont}"
                            FontSize="11"
                            FontWeight="SemiBold">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="core:CustomCodecSpec">
                        <TextBlock Text="{Binding DisplayName}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Panel>
              </Grid>
            </Border>

            <!-- Recessed Well 2: 2x2 Bento Processing Options -->
            <Border Grid.Row="4" Classes="metal-well" Padding="8,7" IsEnabled="{Binding IsFileTransferUnlocked}">
              <Grid RowDefinitions="Auto,6,*">
                <TextBlock Grid.Row="0" Text="PROCESSING OPTIONS" FontSize="10.5" FontWeight="Bold" LetterSpacing="0.8" Foreground="{DynamicResource AeroMutedBrush}" />
                <Grid Grid.Row="2" RowDefinitions="*,6,*" ColumnDefinitions="*,6,*">
                  <Button Grid.Row="0" Grid.Column="0"
                          Classes="metal-button"
                          Classes.under-glow-green="{Binding FmNormGreen}"
                          Classes.under-glow-blue="{Binding FmNormBlue}"
                          IsEnabled="{Binding !IsFmNormLocked}"
                          Opacity="{Binding FmNormOpacity}"
                          Command="{Binding ToggleFmOptionCommand}"
                          CommandParameter="norm"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Padding="8,5"
                          ToolTip.ShowDelay="1000">
                    <ToolTip.Tip>
                      <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                      <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.InfoCircle}" Width="12" Height="12" Foreground="{DynamicResource AeroSkyInkBrush}" />
                      <TextBlock Text="Info" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AeroSkyInkBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                        <TextBlock Text="Balances playback volume across tracks." TextWrapping="Wrap" MaxWidth="230" FontSize="11.5" />
                      </StackPanel>
                    </ToolTip.Tip>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="ReplayGain" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                      <TextBlock Classes="toggle-state" Classes.on-green="{Binding FmNormGreen}" Classes.on-blue="{Binding FmNormBlue}" Text="{Binding FmNormStateText}" FontFamily="{StaticResource AeroMonoFont}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Button>

                  <Button Grid.Row="0" Grid.Column="2"
                          Classes="metal-button"
                          Classes.under-glow-green="{Binding FmTablesGreen}"
                          Classes.under-glow-blue="{Binding FmTablesBlue}"
                          IsEnabled="{Binding !IsFmTablesLocked}"
                          Opacity="{Binding FmTablesOpacity}"
                          Command="{Binding ToggleFmOptionCommand}"
                          CommandParameter="tables"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Padding="8,5"
                          ToolTip.ShowDelay="1000">
                    <ToolTip.Tip>
                      <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                      <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.InfoCircle}" Width="12" Height="12" Foreground="{DynamicResource AeroSkyInkBrush}" />
                      <TextBlock Text="Info" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AeroSkyInkBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                        <TextBlock Text="Rebuilds Sony OMGAUDIO tables required by player's hardware." TextWrapping="Wrap" MaxWidth="230" FontSize="11.5" />
                      </StackPanel>
                    </ToolTip.Tip>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="OMG Tables" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                      <TextBlock Classes="toggle-state" Classes.on-green="{Binding FmTablesGreen}" Classes.on-blue="{Binding FmTablesBlue}" Text="{Binding FmTablesStateText}" FontFamily="{StaticResource AeroMonoFont}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Button>

                  <Button Grid.Row="2" Grid.Column="0"
                          Classes="metal-button"
                          Classes.under-glow-green="{Binding FmLockGreen}"
                          Classes.under-glow-blue="{Binding FmLockBlue}"
                          IsEnabled="{Binding !IsFmLockTrackLocked}"
                          Opacity="{Binding FmLockOpacity}"
                          Command="{Binding ToggleFmOptionCommand}"
                          CommandParameter="lock"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Padding="8,5"
                          ToolTip.ShowDelay="1000">
                    <ToolTip.Tip>
                      <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                      <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.InfoCircle}" Width="12" Height="12" Foreground="{DynamicResource AeroSkyInkBrush}" />
                      <TextBlock Text="Info" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AeroSkyInkBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                        <TextBlock Text="Applies OpenMG / MagicGate encryption framing when required." TextWrapping="Wrap" MaxWidth="230" FontSize="11.5" />
                      </StackPanel>
                    </ToolTip.Tip>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="OpenMG Lock" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                      <TextBlock Classes="toggle-state" Classes.on-green="{Binding FmLockGreen}" Classes.on-blue="{Binding FmLockBlue}" Text="{Binding FmLockStateText}" FontFamily="{StaticResource AeroMonoFont}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Button>

                  <Button Grid.Row="2" Grid.Column="2"
                          Classes="metal-button"
                          Classes.under-glow-green="{Binding FmEjectGreen}"
                          Classes.under-glow-blue="{Binding FmEjectBlue}"
                          IsEnabled="{Binding !IsFmEjectLocked}"
                          Opacity="{Binding FmEjectOpacity}"
                          Command="{Binding ToggleFmOptionCommand}"
                          CommandParameter="eject"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Padding="8,5"
                          ToolTip.ShowDelay="1000">
                    <ToolTip.Tip>
                      <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                      <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.InfoCircle}" Width="12" Height="12" Foreground="{DynamicResource AeroSkyInkBrush}" />
                      <TextBlock Text="Info" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AeroSkyInkBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                        <TextBlock Text="Safely ejects the player automatically after transfer completes." TextWrapping="Wrap" MaxWidth="230" FontSize="11.5" />
                      </StackPanel>
                    </ToolTip.Tip>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="Auto Eject" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                      <TextBlock Classes="toggle-state" Classes.on-green="{Binding FmEjectGreen}" Classes.on-blue="{Binding FmEjectBlue}" Text="{Binding FmEjectStateText}" FontFamily="{StaticResource AeroMonoFont}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </Grid>
              </Grid>
            </Border>

            <!-- Remember Choice Lock -->
            <Button Grid.Row="6"
                    Classes="metal-button"
                    Classes.under-glow-blue="{Binding FmRememberChoice}"
                    IsEnabled="{Binding IsFileTransferUnlocked}"
                    Command="{Binding ToggleFmRememberChoiceCommand}"
                    HorizontalAlignment="Stretch"
                    Height="34">
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.Lock}" Width="13" Height="13" IsVisible="{Binding FmRememberChoice}" Foreground="{DynamicResource AeroSkyInkBrush}" />
                <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.Unlock}" Width="13" Height="13" IsVisible="{Binding !FmRememberChoice}" Foreground="{DynamicResource AeroMutedBrush}" />
                <TextBlock Text="{Binding RememberChoiceLabel}" FontSize="12.5" FontWeight="Bold" />
              </StackPanel>
            </Button>
          </Grid>
      </ctrl:BrushedMetalPanel>

      <!-- RIGHT PANE: IMPORT DESTINATION (Projected Space Bar + Multi-Select Delete + Slot Counter) -->
      <Border Grid.Column="4" Classes="glass-frosted" Padding="16">
        <Grid RowDefinitions="Auto,12,*">
          <StackPanel Grid.Row="0" Spacing="8">
            <Grid ColumnDefinitions="*,Auto,6,Auto">
              <TextBlock Grid.Column="0"
                         Text="IMPORT DESTINATION"
                         Classes="pane-section-header"
                         Foreground="{DynamicResource AeroLimeInkBrush}" />
              <Button Grid.Column="1"
                      Classes="glass-clear"
                      IsEnabled="{Binding IsFileTransferUnlocked}"
                      Command="{Binding ToggleSelectAllFmDestCommand}"
                      Padding="9,4"
                      ToolTip.Tip="Select or deselect all destination tracks">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.CheckAll}" Width="12" Height="12" />
                  <TextBlock Text="Select All" FontSize="11" FontWeight="Medium" />
                </StackPanel>
              </Button>
              <Button Grid.Column="3"
                      Classes="metal-button"
                      IsEnabled="{Binding IsFileTransferUnlocked}"
                      Width="28"
                      Height="28"
                      CornerRadius="9"
                      Padding="0"
                      Command="{Binding RequestCreateCollectionCommand}"
                      ToolTip.Tip="Add New Collection">
                <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.Plus}" Width="13" Height="13" />
              </Button>
            </Grid>

            <Grid ColumnDefinitions="*,8,136">
              <ComboBox Grid.Column="0"
                        Classes="glass-select"
                        IsEnabled="{Binding IsFileTransferUnlocked}"
                        ItemsSource="{Binding DestLocations}"
                        SelectedItem="{Binding SelectedDestLocation}"
                        HorizontalAlignment="Stretch"
                        Height="34" />
              <Grid Grid.Column="2">
                <TextBox Classes="glass-input"
                         Text="{Binding FileManagerRightSearch}"
                         Watermark="Search..."
                         Padding="28,4,26,4"
                         Height="34"
                         FontSize="12" />
                <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.Search}"
                                 Width="12"
                                 Height="12"
                                 Foreground="{DynamicResource AeroSubtleBrush}"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Margin="10,0,0,0"
                                 IsHitTestVisible="False" />
                <Button Classes="glass-clear"
                        IsVisible="{Binding FileManagerRightSearch, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Command="{Binding ClearFmRightSearchCommand}"
                        Width="18"
                        Height="18"
                        CornerRadius="9"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0"
                        ToolTip.Tip="Clear search">
                  <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.Close}" Width="9" Height="9" StrokeThickness="2" />
                </Button>
              </Grid>
            </Grid>

            <Grid ColumnDefinitions="*,6,Auto,6,Auto">
              <ComboBox Grid.Column="0"
                        Classes="glass-select"
                        ItemsSource="{Binding AvailableDestSortFields}"
                        SelectedItem="{Binding FmDestSortField}"
                        Height="30"
                        Padding="8,2"
                        FontSize="11.5"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="Sort destination tracks" />
              <Button Grid.Column="2"
                      Classes="glass-clear"
                      Height="30"
                      Padding="8,0"
                      Command="{Binding ToggleFmDestSortDirectionCommand}"
                      ToolTip.Tip="Toggle sort direction">
                <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.SortArrows}" Width="12" Height="12" />
              </Button>
              <Button Grid.Column="4"
                      Classes="glass-clear"
                      Height="30"
                      Padding="8,0"
                      Command="{Binding CollapseAllFoldersCommand}"
                      CommandParameter="fmdest"
                      ToolTip.ShowDelay="1000">
                <ToolTip.Tip>
                  <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.InfoCircle}" Width="12" Height="12" Foreground="{DynamicResource AeroSkyInkBrush}" />
                      <TextBlock Text="Info" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AeroSkyInkBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Collapses or expands all collections." TextWrapping="Wrap" MaxWidth="220" FontSize="11.5" />
                  </StackPanel>
                </ToolTip.Tip>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.CollapseAll}" Width="12" Height="12" />
                  <TextBlock Text="Collapse All" FontSize="11.5" FontWeight="SemiBold" />
                </StackPanel>
              </Button>
            </Grid>

            <!-- Dual-Segment Projected Storage Bar + OpenMG Slot Pool Badge -->
            <StackPanel IsVisible="{Binding HasDestDeviceSummary}" Spacing="4" Margin="0,2,0,0">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" FontFamily="{StaticResource AeroMonoFont}" FontSize="10.5" Foreground="{DynamicResource AeroMutedBrush}">
                  <Run Text="{Binding DestDeviceSummary.Model}" />
                  <Run Text=" Capacity" />
                </TextBlock>
                <Panel Grid.Column="1">
                  <TextBlock Text="{Binding DestProjectedStorageText}"
                             IsVisible="{Binding !IsTransferOverCapacity}"
                             FontFamily="{StaticResource AeroMonoFont}"
                             FontSize="10.5"
                             Foreground="{DynamicResource AeroMutedBrush}" />
                  <TextBlock Text="{Binding DestProjectedStorageText}"
                             IsVisible="{Binding IsTransferOverCapacity}"
                             FontFamily="{StaticResource AeroMonoFont}"
                             FontSize="10.5"
                             FontWeight="Bold"
                             Foreground="{DynamicResource AeroDangerInkBrush}" />
                </Panel>
              </Grid>

              <Panel Height="7">
                <!-- Projected Segment (warm amber-gold contrast) -->
                <ProgressBar Minimum="0"
                             Maximum="100"
                             Value="{Binding DestProjectedTotalPercent}"
                             Height="7"
                             CornerRadius="3.5"
                             Background="{DynamicResource TroughBgBrush}"
                             Foreground="{DynamicResource ProjectedStoragePreviewBrush}" />
                <!-- Current Used Segment -->
                <ProgressBar Minimum="0"
                             Maximum="100"
                             Value="{Binding DestBaseUsedPercent}"
                             Height="7"
                             CornerRadius="3.5"
                             Background="Transparent"
                             Foreground="{StaticResource AeroAccentGradientBrush}" />
              </Panel>

              <TextBlock IsVisible="{Binding HasDestSlotPool}"
                         Text="{Binding DestSlotPoolText}"
                         FontFamily="{StaticResource AeroMonoFont}"
                         FontSize="10"
                         Foreground="{DynamicResource AeroSkyInkBrush}" />
            </StackPanel>
          </StackPanel>

          <Grid Grid.Row="2" RowDefinitions="Auto,*">
            <Grid Grid.Row="0"
                  ColumnDefinitions="*,Auto,8,64"
                  Margin="4,0,6,0"
                  Height="30">
              <TextBlock Grid.Column="0" Text="On Destination" FontSize="11" Foreground="{DynamicResource AeroMutedBrush}" VerticalAlignment="Center" />
              <Button Grid.Column="1"
                      Classes="glass-clear"
                      Classes.under-glow-danger="{Binding HasSelectedDestTracks}"
                      IsEnabled="{Binding CanDeleteSelectedDest}"
                      Command="{Binding RequestDeleteSelectedDestTracksCommand}"
                      Opacity="1"
                      Padding="9,3"
                      Height="24"
                      CornerRadius="10">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.Trash}" Width="11" Height="11" />
                  <TextBlock Text="{Binding DeleteDestButtonLabel}" FontSize="10.5" FontWeight="SemiBold" />
                </StackPanel>
              </Button>
              <TextBlock Grid.Column="3" Text="Codec" FontSize="11" Foreground="{DynamicResource AeroMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <ListBox x:Name="DestListBox"
                     Grid.Row="1"
                     Classes="aero-track-list"
                     AutoScrollToSelectedItem="False"
                     Padding="0,0,4,12"
                     ItemsSource="{Binding FileManagerDestEntries}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="core:TrackListEntry">
                  <Panel>
                    <Border Classes="dnd-insert-bar"
                            IsVisible="{Binding IsDropTargetBefore}"
                            VerticalAlignment="Top"
                            Margin="4,-1,4,0" />
                    <Button IsVisible="{Binding IsHeader}"
                            Classes="glass-clear"
                            Classes.under-glow-green="{Binding IsStagedHeader}"
                            Classes.folder-selected="{Binding HasSelectedTracks}"
                            Classes.folder-playing="{Binding HasPlayingTrack}"
                            Classes.folder-playing-selected="{Binding HasPlayingAndSelected}"
                            Classes.dnd-folder-drop-over="{Binding IsDropTargetOver}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="8,5"
                            Margin="0,5,0,2"
                            CornerRadius="9"
                            Click="OnFolderHeaderClicked"
                            PointerPressed="OnDestFolderHeaderPointerPressed"
                            PointerMoved="OnDestFolderHeaderPointerMoved"
                            PointerReleased="OnDestFolderHeaderPointerReleased">
                      <Button.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Select Folder" Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).SelectFolderByKeyCommand}" CommandParameter="{Binding HeaderKey}" />
                          <Separator />
                          <MenuItem Header="Set as Target Collection" Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).SetTargetCollectionCommand}" CommandParameter="{Binding HeaderTitle}" />
                          <MenuItem Header="Move Collection Up" Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).MoveCollectionUpCommand}" CommandParameter="{Binding HeaderTitle}" />
                          <MenuItem Header="Move Collection Down" Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).MoveCollectionDownCommand}" CommandParameter="{Binding HeaderTitle}" />
                          <Separator />
                          <MenuItem Header="New Collection..." Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).RequestCreateCollectionCommand}" />
                          <MenuItem Header="Rename Collection..." Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).RequestRenameCollectionCommand}" CommandParameter="{Binding HeaderTitle}" />
                          <MenuItem Header="Delete Collection" Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).DeleteCollectionCommand}" CommandParameter="{Binding HeaderTitle}" />
                        </ContextMenu>
                      </Button.ContextMenu>
                      <Grid ColumnDefinitions="Auto,8,*,12,Auto,8,Auto">
                        <Panel Grid.Column="0" Width="13" Height="13" VerticalAlignment="Center">
                          <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.FolderClosed}" Width="13" Height="13" Foreground="{DynamicResource AeroLimeInkBrush}" IsVisible="{Binding !HasPlayingTrack}" />
                          <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.Play}" Width="11" Height="11" IsFilled="True" Foreground="{DynamicResource AeroLimeInkBrush}" IsVisible="{Binding HasPlayingTrack}" />
                        </Panel>
                        <TextBlock Grid.Column="2" Text="{Binding HeaderTitle}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="{Binding HeaderCountLabel}" FontFamily="{StaticResource AeroMonoFont}" FontSize="11" Foreground="{DynamicResource AeroMutedBrush}" VerticalAlignment="Center" />
                        <ctrl:StrokeIcon Grid.Column="6" Data="{x:Static ctrl:AeroIcons.ChevronDown}" Width="12" Height="12" IsVisible="{Binding IsExpanded}" />
                        <ctrl:StrokeIcon Grid.Column="6" Data="{x:Static ctrl:AeroIcons.ChevronRight}" Width="12" Height="12" IsVisible="{Binding !IsExpanded}" />
                      </Grid>
                    </Button>

                    <Border IsVisible="{Binding IsTrack}"
                            Classes="track-row"
                            Classes.selected="{Binding Track.IsDestSelected, FallbackValue=False}"
                            Classes.playing="{Binding Track.IsNowPlaying, FallbackValue=False}"
                            Classes.staged-new="{Binding Track.IsStagedPreview, FallbackValue=False}"
                            Padding="4,7"
                            Cursor="Hand"
                            PointerPressed="OnPreviewDestRowPressed"
                            PointerMoved="OnDestRowPointerMoved"
                            PointerReleased="OnDestRowPointerReleased">
                      <Border.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Play / Pause" Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).PlayTrackFromMenuCommand}" CommandParameter="{Binding Track}" />
                          <Separator />
                          <MenuItem Header="Move Up" Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).MoveDestTrackUpCommand}" CommandParameter="{Binding Track}" />
                          <MenuItem Header="Move Down" Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).MoveDestTrackDownCommand}" CommandParameter="{Binding Track}" />
                          <MenuItem Header="Set Position in Collection..." Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).RequestSetDestTrackPositionCommand}" CommandParameter="{Binding Track}" />
                          <Separator />
                          <MenuItem Header="Unstage Track" IsVisible="{Binding Track.IsStagedPreview, FallbackValue=False}" Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).UnstageDestPreviewTrackCommand}" CommandParameter="{Binding Track}" />
                          <MenuItem Header="Delete Track..." IsVisible="{Binding !Track.IsStagedPreview, FallbackValue=True}" Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).RequestDeleteSingleDestTrackCommand}" CommandParameter="{Binding Track}" />
                        </ContextMenu>
                      </Border.ContextMenu>
                      <Grid ColumnDefinitions="40,26,*,76">
                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding Track.IsDestSelected, FallbackValue=False}"
                                  IsVisible="{Binding !Track.IsStagedPreview, FallbackValue=True}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Click="OnDestCheckBoxClicked" />
                        <Border Grid.Column="0" Classes="demo-badge" MinWidth="36" Padding="6,2" IsVisible="{Binding Track.IsStagedPreview, FallbackValue=False}" VerticalAlignment="Center" HorizontalAlignment="Center">
                          <TextBlock Text="NEW" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource AeroLimeInkBrush}" />
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding PositionLabel}"
                                   FontFamily="{StaticResource AeroMonoFont}"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource AeroSubtleBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                        <StackPanel Grid.Column="2" Margin="4,0,8,0" Spacing="1">
                          <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding Track.Title}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                            <ctrl:StrokeIcon Grid.Column="1"
                                             Data="{x:Static ctrl:AeroIcons.Shield}"
                                             Width="12"
                                             Height="12"
                                             Margin="0,0,4,0"
                                             IsVisible="{Binding Track.ProtectedLock, FallbackValue=False}"
                                             Foreground="{DynamicResource AeroSkyInkBrush}"
                                             ToolTip.Tip="OpenMG / MagicGate protected" />
                            <Border Grid.Column="2" Classes="demo-badge" VerticalAlignment="Center" IsVisible="{Binding Track.HasSubtitles, FallbackValue=False}">
                              <TextBlock Text="LRC" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AeroLimeInkBrush}" />
                            </Border>
                          </Grid>
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding Track.ArtistAndDuration}" FontSize="11.5" Foreground="{DynamicResource AeroMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                            <TextBlock Grid.Column="1" Text="{Binding Track.RatingFilledStars}" IsVisible="{Binding Track.HasRating, FallbackValue=False}" Classes="rating-stars-amber" />
                          </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="1">
                          <TextBlock Text="{Binding Track.Format}" FontFamily="{StaticResource AeroMonoFont}" FontSize="11.5" HorizontalAlignment="Right" />
                          <TextBlock Text="{Binding Track.GroupDisplay}" FontSize="10.5" Foreground="{DynamicResource AeroSubtleBrush}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </Panel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
