<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Walkman.L3.AppShell.ViewModels"
             xmlns:core="using:Walkman.L3.AppShell.Core"
             xmlns:ctrl="using:Walkman.L3.AppShell.Controls"
             x:Class="Walkman.L3.AppShell.Views.CodecConverterView"
             x:DataType="vm:MainWindowViewModel">
  <Grid RowDefinitions="Auto,16,*">
    <StackPanel Grid.Row="0" Spacing="4">
      <TextBlock Text="Codec Converter" Classes="view-title" />
      <TextBlock Text="{Binding ConverterSubtitle}" Classes="view-subtitle" />
    </StackPanel>

    <Grid Grid.Row="2" ColumnDefinitions="*,16,318,16,*">
      <!-- LEFT COLUMN: INPUT SOURCE (OFFLINE READY) -->
      <Border x:Name="ConvSourceDropPanel" Grid.Column="0" Classes="glass-frosted" Padding="16">
        <Grid RowDefinitions="Auto,12,*">
          <StackPanel Grid.Row="0" Spacing="8">
            <Grid ColumnDefinitions="*,Auto,6,Auto">
              <TextBlock Grid.Column="0"
                         Text="INPUT SOURCE (OFFLINE READY)"
                         Classes="pane-section-header"
                         Foreground="{DynamicResource AeroSkyInkBrush}" />
              <Button Grid.Column="1"
                      Classes="glass-clear"
                      Command="{Binding ToggleSelectAllConvSourceCommand}"
                      Padding="9,4"
                      ToolTip.Tip="Select or deselect all input tracks (Ctrl+A)">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.CheckAll}" Width="12" Height="12" />
                  <TextBlock Text="Select All" FontSize="11" FontWeight="Medium" />
                </StackPanel>
              </Button>
              <Button Grid.Column="3"
                      Classes="glass-clear"
                      Command="{Binding BrowseConverterFolderCommand}"
                      CommandParameter="source"
                      Padding="9,4">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.FolderOpen}" Width="12" Height="12" />
                  <TextBlock Text="Browse..." FontSize="11" FontWeight="Medium" />
                </StackPanel>
              </Button>
            </Grid>

            <Grid ColumnDefinitions="*,8,136">
              <ComboBox Grid.Column="0"
                        Classes="glass-select"
                        ItemsSource="{Binding AllLocations}"
                        SelectedItem="{Binding ConverterSourceLocation}"
                        HorizontalAlignment="Stretch"
                        Height="34" />
              <Grid Grid.Column="2">
                <TextBox x:Name="ConvSearchBox"
                         Classes="glass-input"
                         Text="{Binding ConverterSearch}"
                         Watermark="Search..."
                         Padding="28,4,26,4"
                         Height="34"
                         FontSize="12" />
                <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.Search}"
                                 Width="12"
                                 Height="12"
                                 Foreground="{DynamicResource AeroSubtleBrush}"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Margin="10,0,0,0"
                                 IsHitTestVisible="False" />
                <Button Classes="glass-clear"
                        IsVisible="{Binding ConverterSearch, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Command="{Binding ClearConverterSearchCommand}"
                        Width="18"
                        Height="18"
                        CornerRadius="9"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0"
                        ToolTip.Tip="Clear search">
                  <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.Close}" Width="9" Height="9" StrokeThickness="2" />
                </Button>
              </Grid>
            </Grid>
            <Grid ColumnDefinitions="*,6,Auto,6,Auto">
              <ComboBox Grid.Column="0"
                        Classes="glass-select"
                        ItemsSource="{Binding AvailableSortFields}"
                        SelectedItem="{Binding ConvSortField}"
                        Height="30"
                        Padding="8,2"
                        FontSize="11.5"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="Sort input tracks" />
              <Button Grid.Column="2"
                      Classes="glass-clear"
                      Height="30"
                      Padding="8,0"
                      Command="{Binding ToggleConvSortDirectionCommand}"
                      ToolTip.Tip="Toggle sort direction">
                <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.SortArrows}" Width="12" Height="12" />
              </Button>
              <Button Grid.Column="4"
                      Classes="glass-clear"
                      Height="30"
                      Padding="8,0"
                      Command="{Binding CollapseAllFoldersCommand}"
                      CommandParameter="conv"
                      ToolTip.ShowDelay="1000">
                <ToolTip.Tip>
                  <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.InfoCircle}" Width="12" Height="12" Foreground="{DynamicResource AeroSkyInkBrush}" />
                      <TextBlock Text="Info" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AeroSkyInkBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Collapses or expands all folder groups." TextWrapping="Wrap" MaxWidth="220" FontSize="11.5" />
                  </StackPanel>
                </ToolTip.Tip>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.CollapseAll}" Width="12" Height="12" />
                  <TextBlock Text="Collapse All" FontSize="11.5" FontWeight="SemiBold" />
                </StackPanel>
              </Button>
            </Grid>
          </StackPanel>

          <Grid Grid.Row="2" RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="56,*,64" Margin="4,0,14,0" Height="28">
              <TextBlock Grid.Column="0" Text="Queue" FontSize="11.5" Foreground="{DynamicResource AeroMutedBrush}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Track" FontSize="11.5" Foreground="{DynamicResource AeroMutedBrush}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="Source" FontSize="11.5" Foreground="{DynamicResource AeroMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <ListBox Grid.Row="1"
                     Classes="aero-track-list"
                     AutoScrollToSelectedItem="False"
                     Padding="0,0,4,12"
                     ItemsSource="{Binding ConverterSourceEntries}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="core:TrackListEntry">
                  <Panel>
                    <Button IsVisible="{Binding IsHeader}"
                            Classes="glass-clear"
                            Classes.folder-selected="{Binding HasSelectedTracks}"
                            Classes.folder-playing-selected="{Binding HasPlayingAndSelected}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="8,5"
                            Margin="0,5,0,2"
                            CornerRadius="9"
                            Click="OnFolderHeaderClicked">
                      <Button.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Select Folder" Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).SelectFolderByKeyCommand}" CommandParameter="{Binding HeaderKey}" />
                        </ContextMenu>
                      </Button.ContextMenu>
                      <Grid ColumnDefinitions="Auto,8,*,12,Auto,8,Auto">
                        <Panel Grid.Column="0" Width="13" Height="13" VerticalAlignment="Center">
                          <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.FolderClosed}" Width="13" Height="13" Foreground="{DynamicResource AeroSkyInkBrush}" IsVisible="{Binding !HasPlayingTrack}" />
                          <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.Play}" Width="11" Height="11" IsFilled="True" Foreground="{DynamicResource AeroLimeInkBrush}" IsVisible="{Binding HasPlayingTrack}" />
                        </Panel>
                        <TextBlock Grid.Column="2" Text="{Binding HeaderTitle}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="{Binding HeaderCountLabel}" FontFamily="{StaticResource AeroMonoFont}" FontSize="11" Foreground="{DynamicResource AeroMutedBrush}" VerticalAlignment="Center" />
                        <ctrl:StrokeIcon Grid.Column="6" Data="{x:Static ctrl:AeroIcons.ChevronDown}" Width="12" Height="12" IsVisible="{Binding IsExpanded}" />
                        <ctrl:StrokeIcon Grid.Column="6" Data="{x:Static ctrl:AeroIcons.ChevronRight}" Width="12" Height="12" IsVisible="{Binding !IsExpanded}" />
                      </Grid>
                    </Button>

                    <Border IsVisible="{Binding IsTrack}"
                            Classes="track-row"
                            Classes.selected="{Binding Track.IsSelected, FallbackValue=False}"
                            Classes.playing="{Binding Track.IsNowPlaying, FallbackValue=False}"
                            Padding="4,7"
                            Cursor="Hand"
                            PointerPressed="OnInputRowPressed">
                      <Grid ColumnDefinitions="28,24,*,68">
                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding Track.IsSelected, FallbackValue=False}"
                                  VerticalAlignment="Center"
                                  Click="OnInputCheckBoxClicked" />
                        <Button Grid.Column="1"
                                Classes="glass-clear"
                                Classes.metal-button="{Binding Track.IsNowPlaying, FallbackValue=False}"
                                Classes.under-glow-green="{Binding Track.IsNowPlaying, FallbackValue=False}"
                                Width="22"
                                Height="22"
                                CornerRadius="11"
                                Padding="0"
                                VerticalAlignment="Center"
                                Click="OnPreviewClicked">
                          <Panel>
                            <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.Pause}" Width="9" Height="9" IsFilled="True" IsVisible="{Binding Track.IsActivelyPlaying, FallbackValue=False}" />
                            <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.Play}" Width="10" Height="10" IsFilled="True" IsVisible="{Binding !Track.IsActivelyPlaying, FallbackValue=True}" Margin="1,0,0,0" />
                          </Panel>
                        </Button>
                        <StackPanel Grid.Column="2" Margin="6,0" VerticalAlignment="Center" Spacing="1">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding Track.Title}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                            <Border Grid.Column="1" Classes="demo-badge" VerticalAlignment="Center" IsVisible="{Binding Track.HasSubtitles, FallbackValue=False}">
                              <TextBlock Text="LRC" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AeroLimeInkBrush}" />
                            </Border>
                          </Grid>
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding Track.ArtistAndDuration}" FontSize="11.5" Foreground="{DynamicResource AeroMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                            <TextBlock Grid.Column="1" Text="{Binding Track.RatingFilledStars}" IsVisible="{Binding Track.HasRating, FallbackValue=False}" Classes="rating-stars-amber" />
                          </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="1">
                          <TextBlock Text="{Binding Track.Format}" FontFamily="{StaticResource AeroMonoFont}" FontSize="11.5" HorizontalAlignment="Right" />
                          <TextBlock Text="{Binding Track.SizeFormatted}" FontFamily="{StaticResource AeroMonoFont}" FontSize="11" Foreground="{DynamicResource AeroSubtleBrush}" HorizontalAlignment="Right" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </Panel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Grid>
      </Border>

      <!-- CENTER COLUMN: MACHINED BRUSHED-METAL CONVERTER CONSOLE WITH BENTO WELLS -->
      <ctrl:BrushedMetalPanel Grid.Column="2" IsDark="{Binding IsDark}" CornerRadiusValue="18">
        <Grid RowDefinitions="Auto,10,*,10,Auto,10,*,10,Auto" Margin="12">
          <Button Grid.Row="0"
                  Classes="metal-button"
                  Classes.under-glow-green="{Binding CanStartConvert}"
                  Classes.under-glow-blue="{Binding IsTransferRunning}"
                  IsEnabled="{Binding CanStartConvert}"
                  Command="{Binding StartConversionCommand}"
                  HorizontalAlignment="Stretch"
                  Height="40">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.AudioLines}" Width="14" Height="14" StrokeThickness="2" />
              <TextBlock Text="{Binding ConvertButtonLabel}" FontSize="13" FontWeight="Bold" />
              <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.ArrowRight}" Width="14" Height="14" StrokeThickness="2.1" />
            </StackPanel>
          </Button>

          <!-- Target Codec Bento Well -->
          <Border Grid.Row="2" Classes="metal-well" Padding="9,8">
            <Grid RowDefinitions="Auto,7,*">
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="TARGET CODEC" FontSize="10" FontWeight="Bold" LetterSpacing="0.8" Foreground="{DynamicResource AeroMutedBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding ConverterCodecHint}" FontSize="10" Foreground="{DynamicResource AeroSubtleBrush}" />
              </Grid>

              <Grid Grid.Row="2" RowDefinitions="*,5,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,5,*,5,*">
                  <Button Grid.Column="0" Classes="metal-button" Classes.under-glow-green="{Binding ConvAtracGreen}" Classes.under-glow-blue="{Binding ConvAtracBlue}" IsEnabled="{Binding !IsConvCodecLocked}" Opacity="{Binding ConvAtracOpacity}" Command="{Binding SetConverterCodecCommand}" CommandParameter="{x:Static core:TargetCodec.Atrac3Plus}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <TextBlock Text="ATRAC3+" FontSize="11.5" FontWeight="SemiBold" />
                  </Button>
                  <Button Grid.Column="2" Classes="metal-button" Classes.under-glow-green="{Binding ConvMp3Green}" Classes.under-glow-blue="{Binding ConvMp3Blue}" IsEnabled="{Binding !IsConvCodecLocked}" Opacity="{Binding ConvMp3Opacity}" Command="{Binding SetConverterCodecCommand}" CommandParameter="{x:Static core:TargetCodec.Mp3}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <TextBlock Text="MP3" FontSize="11.5" FontWeight="SemiBold" />
                  </Button>
                  <Button Grid.Column="4" Classes="metal-button" Classes.under-glow-green="{Binding ConvAacGreen}" Classes.under-glow-blue="{Binding ConvAacBlue}" IsEnabled="{Binding !IsConvCodecLocked}" Opacity="{Binding ConvAacOpacity}" Command="{Binding SetConverterCodecCommand}" CommandParameter="{x:Static core:TargetCodec.Aal}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ToolTip.ShowDelay="1000">
                    <ToolTip.Tip>
                      <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                      <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.InfoCircle}" Width="12" Height="12" Foreground="{DynamicResource AeroSkyInkBrush}" />
                      <TextBlock Text="Info" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AeroSkyInkBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                        <TextBlock Text="ATRAC Advanced Lossless (AAL): currently import/decode-only; native AAL hardware encoding is planned." TextWrapping="Wrap" MaxWidth="230" FontSize="11.5" />
                      </StackPanel>
                    </ToolTip.Tip>
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                      <TextBlock Text="AAL" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Border Classes="wip-badge">
                        <TextBlock Text="WIP" Classes="wip-badge-text" />
                      </Border>
                    </StackPanel>
                  </Button>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="*,5,*">
                  <Button Grid.Column="0" Classes="metal-button" Classes.under-glow-green="{Binding ConvFlacGreen}" Classes.under-glow-blue="{Binding ConvFlacBlue}" IsEnabled="{Binding !IsConvCodecLocked}" Opacity="{Binding ConvFlacOpacity}" Command="{Binding SetConverterCodecCommand}" CommandParameter="{x:Static core:TargetCodec.Flac}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <TextBlock Text="FLAC" FontSize="11.5" FontWeight="SemiBold" />
                  </Button>
                  <Button Grid.Column="2" Classes="metal-button" Classes.under-glow-green="{Binding ConvWavGreen}" Classes.under-glow-blue="{Binding ConvWavBlue}" IsEnabled="{Binding !IsConvCodecLocked}" Opacity="{Binding ConvWavOpacity}" Command="{Binding SetConverterCodecCommand}" CommandParameter="{x:Static core:TargetCodec.Wav}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <TextBlock Text="WAV" FontSize="11.5" FontWeight="SemiBold" />
                  </Button>
                </Grid>
              </Grid>
            </Grid>
          </Border>

          <!-- Bitrate & Sample Rate Well (Fixed Height — Zero Vertical Jump!) -->
          <Border Grid.Row="4" Classes="metal-well" MinHeight="96" Padding="9,8">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding ConverterBitrateHeader}" FontSize="10" FontWeight="Bold" LetterSpacing="0.8" Foreground="{DynamicResource AeroMutedBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding ConverterBitrateRightText}" FontFamily="{StaticResource AeroMonoFont}" FontSize="10" Foreground="{DynamicResource AeroSubtleBrush}" />
              </Grid>

              <Panel Height="28">
                <Border Classes="glass-clear-box" CornerRadius="8" IsVisible="{Binding !ShowLossyBitrates}" Padding="8,0">
                  <TextBlock Text="Lossless uncompressed 16-bit PCM"
                             FontFamily="{StaticResource AeroMonoFont}"
                             FontSize="10.5"
                             Foreground="{DynamicResource AeroSkyInkBrush}"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center" />
                </Border>
                <Grid IsVisible="{Binding ShowLossyBitrates}" ColumnDefinitions="*,5,*,5,*,5,*" Height="28">
                  <Button Grid.Column="0" Classes="metal-button" CornerRadius="8" Classes.under-glow-green="{Binding Conv352Green}" Classes.under-glow-blue="{Binding Conv352Blue}" IsEnabled="{Binding !IsConvBitrateLocked}" Opacity="{Binding Conv352Opacity}" Command="{Binding SetConverterBitrateCommand}" CommandParameter="{x:Static core:BitrateOption.K352}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <TextBlock Text="352k" FontFamily="{StaticResource AeroMonoFont}" FontSize="11" FontWeight="SemiBold" />
                  </Button>
                  <Button Grid.Column="2" Classes="metal-button" CornerRadius="8" Classes.under-glow-green="{Binding Conv256Green}" Classes.under-glow-blue="{Binding Conv256Blue}" IsEnabled="{Binding !IsConvBitrateLocked}" Opacity="{Binding Conv256Opacity}" Command="{Binding SetConverterBitrateCommand}" CommandParameter="{x:Static core:BitrateOption.K256}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <TextBlock Text="256k" FontFamily="{StaticResource AeroMonoFont}" FontSize="11" FontWeight="SemiBold" />
                  </Button>
                  <Button Grid.Column="4" Classes="metal-button" CornerRadius="8" Classes.under-glow-green="{Binding Conv192Green}" Classes.under-glow-blue="{Binding Conv192Blue}" IsEnabled="{Binding !IsConvBitrateLocked}" Opacity="{Binding Conv192Opacity}" Command="{Binding SetConverterBitrateCommand}" CommandParameter="{x:Static core:BitrateOption.K192}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <TextBlock Text="192k" FontFamily="{StaticResource AeroMonoFont}" FontSize="11" FontWeight="SemiBold" />
                  </Button>
                  <Button Grid.Column="6" Classes="metal-button" CornerRadius="8" Classes.under-glow-green="{Binding Conv128Green}" Classes.under-glow-blue="{Binding Conv128Blue}" IsEnabled="{Binding !IsConvBitrateLocked}" Opacity="{Binding Conv128Opacity}" Command="{Binding SetConverterBitrateCommand}" CommandParameter="{x:Static core:BitrateOption.K128}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <TextBlock Text="128k" FontFamily="{StaticResource AeroMonoFont}" FontSize="11" FontWeight="SemiBold" />
                  </Button>
                </Grid>
              </Panel>

              <Grid ColumnDefinitions="*,5,*" Height="28">
                <Button Grid.Column="0" Classes="metal-button" CornerRadius="8" Classes.under-glow-green="{Binding Conv441Green}" Classes.under-glow-blue="{Binding Conv441Blue}" IsEnabled="{Binding !IsConvRateLocked}" Opacity="{Binding Conv441Opacity}" Command="{Binding SetConverterSampleRateCommand}" CommandParameter="{x:Static core:SampleRateOption.Hz44100}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                  <TextBlock Text="44.1 kHz" FontFamily="{StaticResource AeroMonoFont}" FontSize="11" FontWeight="SemiBold" />
                </Button>
                <Button Grid.Column="2" Classes="metal-button" CornerRadius="8" Classes.under-glow-green="{Binding Conv480Green}" Classes.under-glow-blue="{Binding Conv480Blue}" IsEnabled="{Binding !IsConvRateLocked}" Opacity="{Binding Conv480Opacity}" Command="{Binding SetConverterSampleRateCommand}" CommandParameter="{x:Static core:SampleRateOption.Hz48000}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                  <TextBlock Text="48 kHz" FontFamily="{StaticResource AeroMonoFont}" FontSize="11" FontWeight="SemiBold" />
                </Button>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Encoding Options 2x2 Bento Well -->
          <Border Grid.Row="6" Classes="metal-well" Padding="9,8">
            <Grid RowDefinitions="Auto,6,*">
              <TextBlock Grid.Row="0" Text="ENCODING OPTIONS" FontSize="10.5" FontWeight="Bold" LetterSpacing="0.8" Foreground="{DynamicResource AeroMutedBrush}" />
              <Grid Grid.Row="2" RowDefinitions="*,6,*" ColumnDefinitions="*,6,*">
                <Button Grid.Row="0" Grid.Column="0" Classes="metal-button" Classes.under-glow-green="{Binding ConvNormGreen}" Classes.under-glow-blue="{Binding ConvNormBlue}" IsEnabled="{Binding !IsConvNormLocked}" Opacity="{Binding ConvNormOpacity}" Command="{Binding ToggleConverterOptionCommand}" CommandParameter="norm" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="8,5" ToolTip.ShowDelay="1000">
                  <ToolTip.Tip>
                    <StackPanel Spacing="2">
                      <StackPanel Orientation="Horizontal" Spacing="5">
                      <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.InfoCircle}" Width="12" Height="12" Foreground="{DynamicResource AeroSkyInkBrush}" />
                      <TextBlock Text="Info" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AeroSkyInkBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                      <TextBlock Text="Applies ReplayGain loudness leveling so converted tracks play at a consistent volume." TextWrapping="Wrap" MaxWidth="230" FontSize="11.5" />
                    </StackPanel>
                  </ToolTip.Tip>
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="ReplayGain" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Classes="toggle-state" Classes.on-green="{Binding ConvNormGreen}" Classes.on-blue="{Binding ConvNormBlue}" Text="{Binding ConvNormStateText}" FontFamily="{StaticResource AeroMonoFont}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" />
                  </StackPanel>
                </Button>

                <Button Grid.Row="0" Grid.Column="2" Classes="metal-button" Classes.under-glow-green="{Binding ConvMetaGreen}" Classes.under-glow-blue="{Binding ConvMetaBlue}" IsEnabled="{Binding !IsConvMetaLocked}" Opacity="{Binding ConvMetaOpacity}" Command="{Binding ToggleConverterOptionCommand}" CommandParameter="meta" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="8,5" ToolTip.ShowDelay="1000">
                  <ToolTip.Tip>
                    <StackPanel Spacing="2">
                      <StackPanel Orientation="Horizontal" Spacing="5">
                      <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.InfoCircle}" Width="12" Height="12" Foreground="{DynamicResource AeroSkyInkBrush}" />
                      <TextBlock Text="Info" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AeroSkyInkBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                      <TextBlock Text="Copies ID3 / OMA metadata tags and embedded album artwork into converted files." TextWrapping="Wrap" MaxWidth="230" FontSize="11.5" />
                    </StackPanel>
                  </ToolTip.Tip>
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Tags &amp; Cover" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Classes="toggle-state" Classes.on-green="{Binding ConvMetaGreen}" Classes.on-blue="{Binding ConvMetaBlue}" Text="{Binding ConvMetaStateText}" FontFamily="{StaticResource AeroMonoFont}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" />
                  </StackPanel>
                </Button>

                <Button Grid.Row="2" Grid.Column="0" Classes="metal-button" Classes.under-glow-green="{Binding ConvKeepGreen}" Classes.under-glow-blue="{Binding ConvKeepBlue}" IsEnabled="{Binding !IsConvKeepLocked}" Opacity="{Binding ConvKeepOpacity}" Command="{Binding ToggleConverterOptionCommand}" CommandParameter="keep" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="8,5" ToolTip.ShowDelay="1000">
                  <ToolTip.Tip>
                    <StackPanel Spacing="2">
                      <StackPanel Orientation="Horizontal" Spacing="5">
                      <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.InfoCircle}" Width="12" Height="12" Foreground="{DynamicResource AeroSkyInkBrush}" />
                      <TextBlock Text="Info" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AeroSkyInkBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                      <TextBlock Text="Keeps original source audio files untouched after conversion completes." TextWrapping="Wrap" MaxWidth="230" FontSize="11.5" />
                    </StackPanel>
                  </ToolTip.Tip>
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Keep Source" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Classes="toggle-state" Classes.on-green="{Binding ConvKeepGreen}" Classes.on-blue="{Binding ConvKeepBlue}" Text="{Binding ConvKeepStateText}" FontFamily="{StaticResource AeroMonoFont}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" />
                  </StackPanel>
                </Button>

                <Button Grid.Row="2" Grid.Column="2" Classes="metal-button" Classes.under-glow-green="{Binding ConvAddGreen}" Classes.under-glow-blue="{Binding ConvAddBlue}" IsEnabled="{Binding !IsConvAddLocked}" Opacity="{Binding ConvAddOpacity}" Command="{Binding ToggleConverterOptionCommand}" CommandParameter="add" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="8,5" ToolTip.ShowDelay="1000">
                  <ToolTip.Tip>
                    <StackPanel Spacing="2">
                      <StackPanel Orientation="Horizontal" Spacing="5">
                      <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.InfoCircle}" Width="12" Height="12" Foreground="{DynamicResource AeroSkyInkBrush}" />
                      <TextBlock Text="Info" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AeroSkyInkBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                      <TextBlock Text="Automatically registers newly converted tracks in your Library view." TextWrapping="Wrap" MaxWidth="230" FontSize="11.5" />
                    </StackPanel>
                  </ToolTip.Tip>
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Add to Library" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Classes="toggle-state" Classes.on-green="{Binding ConvAddGreen}" Classes.on-blue="{Binding ConvAddBlue}" Text="{Binding ConvAddStateText}" FontFamily="{StaticResource AeroMonoFont}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" />
                  </StackPanel>
                </Button>
              </Grid>
            </Grid>
          </Border>

          <Button Grid.Row="8"
                  Classes="metal-button"
                  Classes.under-glow-blue="{Binding ConvRememberChoice}"
                  Command="{Binding ToggleConverterRememberChoiceCommand}"
                  HorizontalAlignment="Stretch"
                  Height="34"
                  ToolTip.ShowDelay="1000">
            <ToolTip.Tip>
              <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="5">
                      <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.InfoCircle}" Width="12" Height="12" Foreground="{DynamicResource AeroSkyInkBrush}" />
                      <TextBlock Text="Info" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AeroSkyInkBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                <TextBlock Text="Locks your current codec, bitrate, and encoding options as defaults." TextWrapping="Wrap" MaxWidth="230" FontSize="11.5" />
              </StackPanel>
            </ToolTip.Tip>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.Lock}" Width="13" Height="13" IsVisible="{Binding ConvRememberChoice}" Foreground="{DynamicResource AeroSkyInkBrush}" />
              <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.Unlock}" Width="13" Height="13" IsVisible="{Binding !ConvRememberChoice}" Foreground="{DynamicResource AeroMutedBrush}" />
              <TextBlock Text="{Binding ConverterRememberLabel}" FontSize="12" FontWeight="Bold" />
            </StackPanel>
          </Button>
        </Grid>
      </ctrl:BrushedMetalPanel>

      <!-- RIGHT COLUMN: OUTPUT DIRECTORY & PROJECTED OUTPUT PREVIEW -->
      <Border Grid.Column="4" Classes="glass-frosted" Padding="16">
        <Grid RowDefinitions="Auto,12,*">
          <StackPanel Grid.Row="0" Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0"
                         Text="OUTPUT FOLDER &amp; PREVIEW"
                         Classes="pane-section-header"
                         Foreground="{DynamicResource AeroLimeInkBrush}" />
              <Button Grid.Column="1"
                      Classes="glass-clear"
                      Command="{Binding BrowseConverterFolderCommand}"
                      CommandParameter="output"
                      Padding="9,4">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <ctrl:StrokeIcon Data="{x:Static ctrl:AeroIcons.FolderOpen}" Width="12" Height="12" />
                  <TextBlock Text="Browse..." FontSize="11" FontWeight="Medium" />
                </StackPanel>
              </Button>
            </Grid>

            <ComboBox Classes="glass-select"
                      ItemsSource="{Binding AllLocations}"
                      SelectedItem="{Binding ConverterOutputLocation}"
                      HorizontalAlignment="Stretch"
                      Height="34" />

            <StackPanel Spacing="4" Margin="0,2,0,0">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding ConverterFootprintLeft}" FontSize="11" Foreground="{DynamicResource AeroMutedBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding ConverterFootprintRight}" FontFamily="{StaticResource AeroMonoFont}" FontSize="11" />
              </Grid>
              <ProgressBar Minimum="0"
                           Maximum="100"
                           Value="{Binding ConverterFootprintPercent}"
                           Height="5"
                           CornerRadius="3"
                           Background="{DynamicResource TroughBgBrush}"
                           Foreground="{StaticResource AeroAccentGradientBrush}" />
            </StackPanel>
          </StackPanel>

          <Grid Grid.Row="2" RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="4,0,6,0" Height="28">
              <TextBlock Grid.Column="0" Text="Projected Output File" FontSize="11" Foreground="{DynamicResource AeroMutedBrush}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Est. Size" FontSize="11" Foreground="{DynamicResource AeroMutedBrush}" VerticalAlignment="Center" />
            </Grid>

            <ListBox Grid.Row="1"
                     Classes="aero-track-list"
                     Padding="0,0,4,12"
                     ItemsSource="{Binding ConverterProjectedOutputs}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ProjectedOutputItem">
                  <Border BorderBrush="{DynamicResource RowDividerBrush}"
                          BorderThickness="0,1,0,0"
                          Padding="4,8">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Margin="0,0,8,0" Spacing="1">
                        <TextBlock Text="{Binding TitleWithExtension}" FontSize="12.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SourceToTargetLabel}" FontSize="11" Foreground="{DynamicResource AeroMutedBrush}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="1">
                        <TextBlock Text="{Binding EstimatedSizeText}" FontFamily="{StaticResource AeroMonoFont}" FontSize="11" Foreground="{DynamicResource AeroLimeInkBrush}" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding OriginalSizeText}" FontFamily="{StaticResource AeroMonoFont}" FontSize="10" Foreground="{DynamicResource AeroSubtleBrush}" HorizontalAlignment="Right" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
