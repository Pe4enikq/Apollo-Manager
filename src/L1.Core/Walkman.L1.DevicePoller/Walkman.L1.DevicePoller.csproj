<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Walkman.L1.DevicePoller</AssemblyName>
    <RootNamespace>Walkman.L1.DevicePoller</RootNamespace>
    <Description>L1 Core Hardware Discovery &amp; Multi-Factor Capability Resolver.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.106">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="NativeMethods.txt" />
    <AdditionalFiles Include="NativeMethods.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Walkman.Contracts\Walkman.Contracts.csproj" />
    <ProjectReference Include="..\Walkman.L1.Orchestrator\Walkman.L1.Orchestrator.csproj" />
  </ItemGroup>
</Project>
